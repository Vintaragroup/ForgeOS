DATABASE_URL="postgresql://<you>@localhost:5432/forgeos_dev?schema=public"

# Signs session cookies (src/lib/session.ts) -- generate your own with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="<generate-a-random-64-char-hex-string>"

# Vercel Blob (src/lib/storage.ts) -- where uploaded document bytes are
# stored, as private (authenticated-only) blobs. No token to set by hand:
# once the project's Blob store is connected via the Vercel dashboard,
# `vercel link` + `vercel env pull .env.local` provisions VERCEL_OIDC_TOKEN
# and BLOB_STORE_ID automatically, and the SDK picks them up on its own.

# UNLIKE the above, this one DOES need to be set by hand. Documents upload
# straight from the browser to Blob (documents/upload-token/route.ts +
# document-upload-form.tsx) rather than through a Server Action's own
# request body -- Vercel Functions enforce their own request-size ceiling
# ahead of anything next.config.ts can promise, which silently 413'd a
# perfectly ordinary 7.2MB upload. Minting the short-lived client upload
# token that path needs has no OIDC fallback in the @vercel/blob SDK at
# all (confirmed from the installed package's own source) -- it's this
# static token or nothing. From the Vercel dashboard: Storage -> the Blob
# store -> .env.local tab.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Powers document analysis (src/lib/ai/document-summary-service.ts) and
# in-app chat (src/lib/chat-service.ts). Without a real key, those features
# render a clear "not configured" state instead of crashing -- everything
# else in the app works fine without this set.
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o"


