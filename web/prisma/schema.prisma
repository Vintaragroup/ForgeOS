// ForgeOS — Phase 2 schema: CRM & opportunity shell.
//
// Scoped to exactly what docs/migration-plan.md Phase 2 needs: Company,
// Contact, Opportunity, User, and a stub Estimate (identity fields only —
// real estimate math is Phase 3). See docs/data-model-v0.md for the full
// entity catalog this is drawn from.
//
// Deliberately single-tenant: no tenant_id anywhere. ForgeOS was scoped as
// an internal tool for one fabrication company, not a multi-tenant SaaS
// product, so docs/data-model-v0.md's "tenant-scoped" language on each
// entity does not apply here.
//
// AuditEvent (the universal audit log in data-model-v0.md) is out of scope
// for Phase 2. Only the one audit requirement Phase 2 explicitly calls for
// -- Opportunity stage-change history, for sales reporting -- is modeled,
// via StageChangeEvent below.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: `url` is no longer valid here. The CLI/Migrate connection
// string lives in prisma.config.ts; the runtime client gets its
// connection via a driver adapter (@prisma/adapter-pg) constructed in
// src/lib/db.ts.
datasource db {
  provider = "postgresql"
}

enum ContactRole {
  CLIENT_CONTACT
  ACCOUNT_EXECUTIVE
}

enum OpportunityStage {
  NEW
  CONTACTED
  QUALIFIED
  ESTIMATING
  WON
  LOST
}

// Captured at the moment an Opportunity moves to WON or LOST -- the one
// piece of context that's impossible to reconstruct after the fact once
// a deal is closed and everyone's moved on. Shared between both outcomes
// rather than two separate enums since most reasons genuinely apply to
// either side of the same axis (e.g. PRICE: won or lost on price is the
// same underlying fact, just a different sign).
enum CloseReason {
  PRICE
  TIMELINE
  SCOPE_FIT
  COMPETITOR
  BUDGET_CANCELLED
  NO_RESPONSE
  RELATIONSHIP
  OTHER
}

enum EstimateStatus {
  DRAFT
  IN_PROGRESS
}

// Access control, distinct from the free-text `role` field below (which is
// a job title like "Senior Estimator", not a permission level). SUPER_ADMIN
// can create ADMIN or EMPLOYEE users; ADMIN can only create EMPLOYEE --
// enforced server-side in src/app/admin/users/actions.ts, not just hidden
// in the UI. See README's Admin section.
enum SystemRole {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
}

model User {
  id                String     @id @default(cuid())
  name              String
  email             String     @unique
  role              String? // job title, e.g. "Estimator" -- not access control
  department        String?
  systemRole        SystemRole @default(EMPLOYEE)
  // scrypt "salt:hash" pair, set via `npm run set-password` -- never through
  // a web form, so there is no unauthenticated password-set endpoint. Null
  // until set, meaning the account can't log in yet. See src/lib/auth.ts.
  passwordHash      String?
  // Item #7 of the security/hardening roadmap: embedded as a claim inside
  // the signed session cookie at issue time (session.ts's
  // buildSessionValue) and compared against this column on every request
  // that hits the DB (auth.ts's getCurrentUser) -- a session issued
  // before this timestamp is rejected even if its signature/expiry are
  // still valid, so a stolen/leaked session cookie stops working the
  // moment the legitimate owner changes their password. Null means
  // "never explicitly changed since this column existed" -- treated as
  // no constraint, not as an error, so it stays backward-compatible with
  // every user row that predates this column.
  passwordChangedAt DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  contactLinks    Contact[]                 @relation("UserContact")
  opportunities   Opportunity[]             @relation("OpportunityOwner")
  collaboratingOn OpportunityCollaborator[] @relation("OpportunityCollaborator")

  approvedEstimateVersions EstimateVersion[]     @relation("EstimateVersionApprover")
  uploadedAttachments      Attachment[]
  assignedTasks            Task[]
  recordedCostActuals      CostActual[]
  adminAuditLogsActed      AdminAuditLog[]       @relation("AdminAuditLogActor")
  adminAuditLogsTargeted   AdminAuditLog[]       @relation("AdminAuditLogTarget")
  lineItemAuditLogs        LineItemAuditLog[]
  uploadedDocuments        Document[]
  deadlineActionsTaken     DeadlineAction[]
  aiUsageEvents            AiUsageEvent[]
  vendorMatchApplyLogs     VendorMatchApplyLog[]

  @@map("users")
}

model Company {
  id             String  @id @default(cuid())
  name           String
  billingAddress String?
  industry       String?

  // Default tax jurisdiction for this client's billing location --
  // Opportunity.taxRateId defaults from this when an opportunity is
  // created, and Estimate.taxRateId defaults from the opportunity in turn.
  // Each level can still override.
  taxRateId String?
  taxRate   TaxRate? @relation(fields: [taxRateId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  contacts      Contact[]
  opportunities Opportunity[]

  @@map("companies")
}

// A Contact is either a client_contact (belongs to a Company) or an
// account_executive (linked back to an internal User) -- see
// docs/data-model-v0.md's Contact entity. Both cases share this table
// rather than being split, matching how the workbook treated them (one
// "contact directory" concept, DATA!B24:F33, regardless of which side of
// the deal the person is on).
model Contact {
  id    String      @id @default(cuid())
  name  String
  email String?
  phone String?
  role  ContactRole

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  userId String? // set when role = ACCOUNT_EXECUTIVE and linked to an internal User
  user   User?   @relation("UserContact", fields: [userId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  opportunitiesAsPrimary Opportunity[] @relation("OpportunityPrimaryContact")

  @@map("contacts")
}

// Drives which onboarding field group renders on the opportunity detail
// page -- see data/historical_jobs/xlsx's "Start Page" tab, which is
// booth-fields-only (fine when every job really was a tradeshow exhibit,
// not true once Expo also books events, I&D-only exhibitor contracts, and
// one-off experiential/specialized builds). Defaulted to TRADESHOW_EXHIBIT
// on the migration backfill since every pre-existing row really was one.
enum ProjectType {
  TRADESHOW_EXHIBIT
  EVENT
  EXHIBITOR_CONTRACTING
  SPECIALIZED_PROJECT
  OTHER
}

enum BoothType {
  RENTAL
  PURCHASE
  CLIENT_OWNED
}

enum BoothSpace {
  ISLAND
  PENINSULA
  IN_LINE
  PERIMETER
}

model Opportunity {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  projectType ProjectType @default(TRADESHOW_EXHIBIT)

  primaryContactId String?
  primaryContact   Contact? @relation("OpportunityPrimaryContact", fields: [primaryContactId], references: [id])

  ownerId String?
  owner   User?   @relation("OpportunityOwner", fields: [ownerId], references: [id])

  showName      String
  boothNumber   String?
  targetMoveIn  DateTime?
  targetMoveOut DateTime?
  stage         OpportunityStage @default(NEW)

  // Onboarding details beyond the workbook's tradeshow-only "Start Page"
  // fields -- all nullable at the DB level (which fields are "required"
  // depends on projectType and is enforced by the onboarding form, not a
  // column constraint Postgres can't express per-enum-value anyway).
  // venue/eventStartDate/eventEndDate are universal across every type
  // (the show/event's own open-close window -- distinct from
  // targetMoveIn/targetMoveOut above, which is the install/strike
  // window). boothSize/boothSpace/boothType/shipDate are tradeshow-
  // specific. siteAddress and the projectDetails free-text catch-all are
  // for SPECIALIZED_PROJECT/OTHER, where most detail comes from AI
  // reading uploaded RFPs/meeting notes rather than a fixed field list --
  // see document-summary-service.ts's extractedFields.
  venue          String?
  eventStartDate DateTime?
  eventEndDate   DateTime?
  boothSize      String?
  boothSpace     BoothSpace?
  boothType      BoothType?
  shipDate       DateTime?
  siteAddress    String?
  projectDetails String?

  // Defaults from Company.taxRateId at creation time, overridable per show
  // (e.g. a client based in Chicago exhibiting at a show in Orlando).
  taxRateId String?
  taxRate   TaxRate? @relation(fields: [taxRateId], references: [id])

  // Set by changeOpportunityStage (opportunity-service.ts) only at the
  // moment stage becomes WON or LOST, and cleared if it ever moves away
  // from either -- a stale reason attached to a reopened deal would be
  // actively misleading, not just unused. One reason per opportunity, not
  // per StageChangeEvent: a deal closes once in the common case, and
  // admin-analytics.ts's breakdown wants a direct groupBy here, not a
  // join through stage-change history to find "the" closing event.
  closeReason       CloseReason?
  closeReasonDetail String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Cache of the last "Generate clarification questions" run
  // (clarification-questions-service.ts) -- { generatedAt, questions:
  // ClarificationQuestion[] }. Null until run once. Same posture as
  // EstimateVersion.coverageAnalysis: explicitly-triggered, deliberately
  // expensive, full-overwrite on re-run rather than live-recomputed.
  clarificationQuestions Json?

  stageEvents StageChangeEvent[]
  estimates   Estimate[]
  projects    Project[]
  documents   Document[]
  chatThread  ChatThread?

  // Access control: an owner always has access; a collaborator is anyone
  // else explicitly granted access (see src/lib/opportunity-access.ts).
  // ADMIN/SUPER_ADMIN bypass this entirely and see every Opportunity
  // regardless of ownership/collaboration.
  collaborators OpportunityCollaborator[]

  deadlineActions DeadlineAction[]
  aiUsageEvents   AiUsageEvent[]

  @@map("opportunities")
}

model OpportunityCollaborator {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  userId        String
  user          User        @relation("OpportunityCollaborator", fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([opportunityId, userId])
  @@map("opportunity_collaborators")
}

enum DeadlineActionStatus {
  SCHEDULED
  SUBMITTED
  PAID
}

// A lightweight acknowledgment against one Dashboard "upcoming deadline" --
// not a real reminders/notifications engine (that's still gated on the B6
// email/Slack provider decision). dedupeKey matches the same fact-identity
// string dashboard.ts already computes to dedupe a restated RFP date or
// identify a WorkOrder date field, so one acknowledgment covers a deadline
// no matter how many source documents restate it.
model DeadlineAction {
  id            String               @id @default(cuid())
  opportunityId String
  opportunity   Opportunity          @relation(fields: [opportunityId], references: [id])
  dedupeKey     String
  status        DeadlineActionStatus
  actedById     String?
  actedBy       User?                @relation(fields: [actedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([opportunityId, dedupeKey])
  @@map("deadline_actions")
}

enum AiFeature {
  DOCUMENT_SUMMARY
  DRAWING_SUMMARY
  SCOPE_LINE_ITEMS
  DRAWING_LINE_ITEMS
  VENDOR_QUOTE_LINE_ITEMS
  CHAT
  SCOPE_COVERAGE_ANALYSIS
  RFP_CLARIFICATION_QUESTIONS
  VENDOR_LINE_MATCH
  SPREADSHEET_LINE_ITEMS
  SECTION_DESCRIPTION
  // Chat roadmap Phase 3: embedding a document's chunks at analysis time
  // (document-embedding-service.ts's indexDocument) and embedding each
  // chat question at retrieval time both record here -- tracked apart
  // from CHAT since it's a different OpenAI endpoint (embeddings, not
  // chat completions) with its own per-token rate.
  DOCUMENT_EMBEDDING
}

// One row per OpenAI call, for case-based model routing's cost/token
// tracking (see src/lib/ai/ai-usage-service.ts and openai-client.ts's
// BASIC_MODEL/ADVANCED_MODEL split). All foreign keys nullable, mirroring
// Document.uploadedById -- a usage row should never fail to record just
// because one piece of context (a deleted user, a call outside any
// opportunity) is missing.
model AiUsageEvent {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  feature AiFeature
  model   String // the literal model string sent to OpenAI, e.g. "gpt-4o-mini"

  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  // Decimal, not Float, same reasoning as every money field in this
  // schema. 6 places, not the usual 2/4 -- a sub-cent gpt-4o-mini call
  // would round to 0.0000 at 4 places, making per-call rows useless for
  // auditing even though rollup sums would still be accurate either way.
  estimatedCostUsd Decimal @db.Decimal(10, 6)

  documentId    String?
  document      Document?    @relation(fields: [documentId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("ai_usage_events")
}

// ---------------------------------------------------------------------
// Phase 7: document ingestion & AI project understanding
// (data/RFP/superbowl's two real RFP packages are this feature's roadmap).
//
// Opportunity-scoped, not Estimate-scoped like Attachment -- RFP/client
// documents exist BEFORE an Estimate does (that's the whole premise of
// "start an estimate from the documents"), so Document can't be
// represented as an Attachment (Attachment.estimateId is a required FK).
// Attachment's own comment already named this exact gap: "no automated
// pull-sheet table extraction this phase." This model is that phase.
// ---------------------------------------------------------------------

enum DocumentType {
  RFP
  SCOPE_OF_WORK
  PRICING_SCHEDULE
  DRAWING
  CONTRACT
  SCHEDULE
  // Meeting transcripts/recaps/emails -- distinct from RFP/SCOPE_OF_WORK
  // because the content genuinely needs different handling: a transcript
  // mixes real scope facts with off-topic chatter (internal tooling
  // discussion, mentions of an unrelated client/project) that a generic
  // summarizer would happily extract as if it were scope. See
  // meeting-notes-summary-service.ts.
  MEETING_NOTES
  // A third party's priced bid for a BidPackage -- see vendor-match-
  // service.ts and Document.vendorQuoteLineItems. Handled generically by
  // the existing Analyze pipeline (analyze-document.ts's dispatch falls
  // through to the same text summarizer every non-DRAWING/MEETING_NOTES
  // type already uses), so nothing else in the extraction pipeline needs
  // to special-case this value.
  VENDOR_QUOTE
  OTHER
}

// UNSUPPORTED is a real, expected outcome (e.g. a CAD-exported drawing
// PDF with no extractable text), not an error -- see document-service.ts.
enum ExtractionStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
  UNSUPPORTED
}

model Document {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  filename     String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  documentType DocumentType

  // Optional manual hint for a multi-project Opportunity (two or more
  // Estimates) -- set on a document that's cleanly single-project (e.g.
  // a rendering package for one specific exhibit) so its facts don't
  // need AI classification at all: every extracted item inherits this
  // tag directly. Left null for a document that genuinely discusses
  // multiple projects (a meeting transcript) -- those get classified at
  // the individual-fact level instead (see document-summary-service.ts's
  // KeyDateFact/CitedText estimateId field). Meaningless and ignored for
  // a single-estimate Opportunity, which is still the common case.
  estimateId String?
  estimate   Estimate? @relation(fields: [estimateId], references: [id])

  extractionStatus  ExtractionStatus @default(PENDING)
  extractedText     String?          @db.Text
  extractedSummary  Json?
  // AI-proposed, unpriced draft line items read from this document's
  // Scope of Work text -- separate from extractedSummary because it's a
  // distinct, explicitly-triggered operation (see scope-line-item-service.ts),
  // not part of the automatic Project Brief analysis every document goes
  // through. Cached here so re-opening the Estimate's proposal preview
  // doesn't re-run the OpenAI call on every page load.
  proposedLineItems Json?

  // Parallel to proposedLineItems above, but a distinct shape (includes
  // unitPrice/totalPrice) -- populated only for a VENDOR_QUOTE document
  // by vendor-quote-service.ts's proposeVendorQuoteLineItems, matched at
  // render time against a BidPackage's line items rather than committed
  // as new rows the way proposedLineItems is. See BidPackage's own
  // comment for why a vendor quote's price never gets read through the
  // proposedLineItems/commitScopeLineItems path -- that schema has no
  // price field at all, by design, for ExpoCCI's own scope documents.
  vendorQuoteLineItems Json?

  // Verbatim "Build Name:" field read from a Design Cost Estimate booth
  // workbook (design-cost-estimate-import-service.ts) -- the only signal
  // in that template that two independently-uploaded documents are the
  // SAME booth design (a genuine "mirror build": one section copied
  // wholesale, or re-quantified, from another's engineering rather than
  // independently priced). Compared across sibling documents on the same
  // opportunity at import-preview time to surface a flag-only banner --
  // never used to auto-copy pricing, a human always decides. Null for
  // every other document type/shape.
  buildName String?

  // Set once this document is attached to a BidPackage as its vendor's
  // quote -- null until then, same as estimateId above. A VENDOR_QUOTE
  // document is uploaded generically (Opportunity Documents card, same
  // as every other document type) and attached to a package afterward,
  // not uploaded through a package-specific form.
  bidPackageId String?
  bidPackage   BidPackage? @relation(fields: [bidPackageId], references: [id])

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  // Sibling to LineItem.attachmentId's existing isDraft/confirm flow --
  // a document-sourced draft line item reviews through the exact same
  // mechanism, not a new one.
  lineItems            LineItem[]
  aiUsageEvents        AiUsageEvent[]
  vendorMatchApplyLogs VendorMatchApplyLog[]
  chunks               DocumentChunk[]

  @@map("documents")
}

// Chat roadmap Phase 3: a document's extractedText, split into
// overlapping chunks and embedded once at analysis time (document-
// embedding-service.ts), so a chat question retrieves only the handful
// of chunks actually relevant to it instead of every document's full
// text competing for one fixed character budget (chat-context-
// service.ts's previous approach -- still the fallback for a document
// with no chunks yet, e.g. one analyzed before this existed).
// opportunityId is denormalized off Document purely so a per-opportunity
// similarity search doesn't need a join on every chat message.
model DocumentChunk {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  opportunityId String

  chunkIndex Int
  content    String @db.Text

  // pgvector's own type -- Prisma has no native vector type, so every
  // read/write of this column goes through $queryRaw/$executeRaw (see
  // document-embedding-service.ts), never the generated Client API.
  // 1536 dims = OpenAI text-embedding-3-small (EMBEDDING_MODEL) at its
  // default size -- changing that model/size means re-embedding every
  // existing chunk, not just new ones.
  embedding Unsupported("vector(1536)")

  createdAt DateTime @default(now())

  @@index([documentId])
  @@index([opportunityId])
  @@map("document_chunks")
}

model StageChangeEvent {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  fromStage OpportunityStage?
  toStage   OpportunityStage
  note      String?
  changedAt DateTime          @default(now())

  @@map("opportunity_stage_events")
}

// Identity + status only. All pricing detail lives on EstimateVersion --
// see data-model-v0.md's Estimate entity: "the single most important
// structural correction ForgeOS must make relative to the workbook,
// which has no version concept at all."
model Estimate {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  // Null for the common single-estimate Opportunity (nothing to
  // distinguish it from). Set once an Opportunity has multiple Estimates
  // in play at once (e.g. two separate exhibits for one client) so each
  // one is identifiable in the UI and usable as a project label for AI
  // extraction -- see document-summary-service.ts's estimateId
  // resolution and opportunities/[id]/page.tsx's grouped Project Brief.
  name String?

  budget Decimal?       @db.Decimal(12, 2)
  status EstimateStatus @default(DRAFT)

  // Replaces the old free-text taxCity field (a label nothing ever read --
  // no calculation used it). A real jurisdiction, so the proposal PDF can
  // compute an actual estimated-tax line against it -- see
  // proposal-view-model.ts's Total Taxable, which this multiplies by.
  taxRateId String?
  taxRate   TaxRate? @relation(fields: [taxRateId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Distinct from deletedAt above -- deletedAt means "gone everywhere,"
  // the same convention every other model in this app uses (Document,
  // Attachment, Proposal, Opportunity); archivedAt means "hidden from the
  // active Estimates list, but still fully viewable for reference and
  // restorable." Set/cleared by archiveEstimate/unarchiveEstimate
  // (estimate-service.ts); assertUnlocked and the top-level Estimate
  // mutations reject any edit while it's set.
  archivedAt DateTime?

  versions     EstimateVersion[]
  changeOrders ChangeOrder[]
  attachments  Attachment[]
  documents    Document[]

  @@map("estimates")
}

// ---------------------------------------------------------------------
// Phase 3: native estimate engine (docs/migration-plan.md).
//
// Deliberately NOT ported this phase: PRICE OPTIONS' margin-tier logic
// (business-rules.md Rule 7) -- its 43/57...65/35 tiers and x1.075
// multiplier have no confirmed business meaning even after the sheet was
// proven mechanically repairable in Phase 1. The engine below implements
// only Price Summary's gross-up formula (Rule 6), the mechanism actually
// confirmed to produce real client-facing totals (Yoku Moku, Booksy).
//
// Option (alternates, one full EstimateSection set per OPTION sheet) is
// also deferred -- not built this phase. Noted, not silently dropped.
// ---------------------------------------------------------------------

enum LaborRateType {
  DEPARTMENT
  CITY_MARKET
}

// The proposal-facing category taxonomy, moved from a hardcoded
// TypeScript constant (line-item-category.ts's old CANONICAL_CATEGORIES)
// to a real catalog once estimators needed to edit it themselves --
// add/rename/reorder categories and define sub-categories, not just the
// one hardcoded Structure-under-Custom-Build case. LineItem.category
// stays a plain string (matched against this table's `name` at render
// time), not a foreign key -- every existing comparison in the codebase
// is a string equality check, and converting would mean migrating every
// historical LineItem row plus every call site for no behavioral gain.
//
// parentId supports exactly one level of nesting (a child's own parentId
// must point at a top-level category, not another child) -- matches what
// buildTopLevelCategoryViews (proposal-view-model.ts) actually renders:
// a top-level section with its direct children nested under it, not an
// arbitrary tree. sortOrder controls render order on the proposal PDF/
// web view, same meaning as EstimateSection.sortOrder but for this
// unrelated grouping axis.
model Category {
  id       String     @id @default(cuid())
  name     String     @unique
  // Stable identifier the categorization heuristics (line-item-category.ts)
  // resolve against -- set once at creation (slugified from name, see
  // categories/actions.ts's createCategory) and never regenerated on a
  // later rename, unlike `name`, which /catalog/categories lets an
  // estimator freely edit. Exists specifically so a display-name rename
  // ("Custom Build" -> "Custom Build / Rental") can't silently break every
  // *future* categorization decision the way it broke every *existing*
  // LineItem before updateCategory's rename cascade existed -- name drift
  // is handled for existing data by that cascade; key stability is what
  // prevents it for data written after the rename.
  key      String     @unique
  parentId String?
  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")

  sortOrder Int @default(0)

  // Professional Services/Labor/Shipping render as a description + price
  // line with no qty/unit columns (priced as a lump sum), matching every
  // historical proposal's "On site labor" / "Shipping" / bulleted
  // scope-of-services treatment -- everything else itemizes with qty/unit.
  isLumpSum     Boolean @default(false)
  // Labor/Shipping roll into the proposal's "Show Services" subtotal
  // instead of "Rental Components" -- Professional Services is lump-sum
  // (isLumpSum) but still rolls into Rental Components, so this is a
  // second, independent flag, not implied by isLumpSum.
  isShowService Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  marginOverrides CategoryMarginOverride[]

  @@map("categories")
}

// A per-EstimateVersion margin override for one Category -- lets an
// estimator price e.g. Structure differently from Labor, instead of the
// single version-wide EstimateVersion.marginTargetPct applying uniformly
// everywhere. `categoryId` can point at a primary Type row (Structure) or
// a Method leaf (Structure - Rental) -- the schema doesn't care; only
// Type-level rows get an editable UI control for now (see
// resolveLineItemMarginPct's own comment for the leaf-then-Type-then-
// document fallback order this feeds). One row per (version, category);
// deleting a row (not zeroing marginPct) is how an estimator reverts a
// category back to inheriting the document's own target.
model CategoryMarginOverride {
  id                String          @id @default(cuid())
  estimateVersionId String
  estimateVersion   EstimateVersion @relation(fields: [estimateVersionId], references: [id])
  categoryId        String
  category          Category        @relation(fields: [categoryId], references: [id])

  marginPct Decimal @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([estimateVersionId, categoryId])
  @@map("category_margin_overrides")
}

// Only meaningful for CITY_MARKET rows -- DEPARTMENT (shop) rates are a
// single flat number with no time-and-a-half concept, per how this
// catalog is actually used (see LaborRate's comment). Real market data
// (data/Catalog_Data/.../labor_rates_show_site.csv) shows OT/DT are NOT
// a clean 1.5x/2x multiple of straight time -- Chicago's OT is 1.34x its
// ST, Huntsville's is 1.57x -- so each tier is its own stored rate, never
// computed from a multiplier.
enum LaborRateTier {
  STRAIGHT_TIME
  OVERTIME
  DOUBLE_TIME
}

// Left null (unspecified) rather than defaulted to either value when the
// source data doesn't actually distinguish union from non-union labor --
// see labor_rates_show_site.csv's own comment for why the seeded
// 78-market rates don't assert one. Only meaningful for CITY_MARKET rows,
// same as laborTier.
enum LaborUnionStatus {
  UNION
  NON_UNION
}

// Unifies business-rules.md Rule 1 (15 department rates, hardcoded on
// COMPONENT 1 and fanned out by formula to 43 sibling sheets) and Rule 10
// (a city rate table with zero formula consumers anywhere in the
// workbook) into one catalog with a rate_type discriminator -- exactly
// the remediation data-model-v0.md's LaborRate entity proposed.
//
// DEPARTMENT = shop labor (Design, Metal, CNC, Carpenters, etc.) -- one
// flat rate, no tier/union concept. CITY_MARKET = show/event site labor,
// where laborTier and unionStatus apply: a market typically has 2-3 rows
// (straight time always, overtime almost always, double time only where
// the source data actually has one -- 15 of 78 markets).
model LaborRate {
  id             String            @id @default(cuid())
  rateType       LaborRateType
  departmentCode String? // e.g. "DE", "EN" -- business-rules.md Rule 1's 15 codes
  departmentName String?
  city           String?
  laborTier      LaborRateTier?
  unionStatus    LaborUnionStatus?
  // e.g. "Travel Required", "Travel Required outside of Bay Area" --
  // straight from the source rate card, operationally relevant (travel
  // cost/logistics), not just decorative.
  notes          String?
  rate           Decimal           @db.Decimal(10, 2)
  effectiveDate  DateTime          @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("labor_rates")
}

// One combined sales tax rate per jurisdiction (state + local county/city
// already rolled into one number), not separate state/local rates that
// stack -- how they combine varies by state and would need a real tax-rate
// API (Avalara, TaxJar) to get right; ForgeOS doesn't have that
// integration. city is optional the same way LaborRate's is: a
// state-level default when no more specific local rate has been entered.
// Seeded rows (scripts/seed-tax-rates.ts) are real published combined
// rates for major trade-show markets, each with a citable source and
// effectiveDate -- not guesses. Verify/update before relying on them for
// actual tax collection, since local rates change over time.
model TaxRate {
  id            String   @id @default(cuid())
  state         String // 2-letter USPS code, e.g. "FL"
  city          String?
  // Optional human label for the jurisdiction picker, e.g. "Orange County, FL"
  // -- falls back to "city, state" or just "state" when unset.
  label         String?
  rate          Decimal  @db.Decimal(6, 4) // e.g. 0.0650 for 6.5%
  effectiveDate DateTime @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  companies     Company[]
  opportunities Opportunity[]
  estimates     Estimate[]

  @@map("tax_rates")
}

// Cut-list phase 0: only meaningful for a Material that's actually
// cuttable raw stock (plywood, MDF, dimensioned lumber) -- left null for
// every other Material row (hardware, adhesives, paint, etc.), same
// optional posture as `unit`/`category` above. SHEET has both
// stockWidth and stockLength (a sheet good); LINEAR has stockLength only
// (a board -- cut to length, no meaningful "width" to nest against).
enum MaterialType {
  SHEET
  LINEAR
}

model Material {
  id              String  @id @default(cuid())
  name            String
  unit            String?
  currentUnitCost Decimal @db.Decimal(10, 2)
  category        String?
  // Same pattern as RentalItem.priceDerivationNote below -- where a price
  // came from a real job (which one(s), how many times observed) vs. a
  // researched industry-reference starting point pending the shop's real
  // supplier costs. Keeps that distinction from getting silently lost.
  sourceNote      String?

  // Cut-list phase 0 (cut-list-service.ts): structured stock dimensions,
  // all in inches -- the standard unit for shop-floor cut lists in this
  // industry, same convention CutList Plus itself defaults to. Null on
  // every Material row until someone opts a specific catalog entry into
  // being real cuttable stock by filling these in; nothing about the
  // existing catalog changes for a row that never gets them set.
  materialType          MaterialType?
  stockWidth            Decimal?      @db.Decimal(8, 3)
  stockLength           Decimal?      @db.Decimal(8, 3)
  thickness             Decimal?      @db.Decimal(8, 3)
  // Saw kerf width -- the material actually lost to each cut, not just a
  // display value. Feeds directly into the nesting engine (phase 2) as
  // the per-part inflation amount; a part-level override isn't needed
  // yet since kerf is a property of the saw/material combo, not the part.
  defaultKerf           Decimal?      @db.Decimal(6, 3)
  // True when parts cut from this material must keep a fixed orientation
  // (visible wood grain, a directional laminate/finish) -- read by the
  // nesting engine (phase 2) to disable rotation for any CutListPart that
  // inherits this, the same way Document.estimateId is inherited rather
  // than re-decided per part.
  grainDirectionMatters Boolean       @default(false)

  cutListParts     CutListPart[]
  cutSheets        CutSheet[]
  materialRemnants MaterialRemnant[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("materials")
}

// business-rules.md Rule 9: Standard Cost Sheet's flat rental prices,
// including one embedded-derivation formula ("=(35*2)*1.25") -- carried
// forward here as priceDerivationNote so the reasoning isn't lost the
// way it was in the original workbook.
model RentalItem {
  id                  String  @id @default(cuid())
  name                String
  unitPrice           Decimal @db.Decimal(10, 2)
  priceDerivationNote String?
  // Added alongside a real catalog expansion (rentals_master.csv /
  // BeMatrix rental accessories) -- Material already had this; RentalItem
  // didn't, and the source data's own category groupings (Furniture, A/V,
  // Flooring, etc.) shouldn't get flattened away just because the column
  // didn't exist yet.
  category            String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("rental_items")
}

enum SectionType {
  COMPONENT
  CATEGORY
  FEE
}

// The acquisition Method for a booth/component section (one with
// groupLabel set) -- how it's being obtained, never what it physically
// is. That's the crucial distinction from earlier in this enum's life:
// this used to also stand in for the item's whole category (Rental
// Structures vs. Custom Components), discarding each line item's own
// real type (Structure/Furniture/Audio-Visual/...) in the process --
// confirmed live as a real bug (an Audio/Visual vendor bid tagged this
// way lost ~$50k of AV content into a generic Custom-Build bucket).
// Today this ONLY supplies Method; a tagged section's line items still
// resolve their own Type independently (resolveAcquisitionMethod /
// resolveEffectiveCategory in line-item-category.ts /
// proposal-view-model.ts), composing into e.g. "Audio/Visual - Rental"
// rather than replacing the item's category outright. Only an
// estimator's real-world deal knowledge can set this, never inferred
// from import data for the section-level tag itself (per-item inference
// exists separately, see resolveAcquisitionMethod's own comment). Not
// meaningful for a section with no groupLabel.
enum SectionBuildType {
  RENTAL
  CUSTOM_BUILD
  PURCHASE
}

// A per-line-item manual tag for a material that's genuinely ambiguous on
// its own -- PVC sheet material, for one, is used both as rigid rental
// panel stock and as a printable graphic substrate, and nothing about its
// own description or catalog match can tell those apart the way SEG
// fabric's own text unambiguously can (see isAlwaysGraphicsDescription in
// line-item-category.ts). Null (the default) means "not yet decided,"
// same posture as SectionBuildType above -- an estimator sets this
// explicitly per item; it's never inferred.
enum LineItemUsageTag {
  RENTAL_PANEL
  GRAPHIC
}

enum LineItemType {
  MATERIAL
  LABOR
  FEE
}

// Immutable once locked -- the structural fix for the workbook's total
// lack of version history (docs/workflow-map.md's "Key finding").
// isCurrent marks which version is the active one for its Estimate;
// isLocked marks whether it can still be edited. "Create new version"
// duplicates a locked version's sections/line items into a fresh,
// unlocked one rather than mutating history.
model EstimateVersion {
  id         String   @id @default(cuid())
  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id])

  versionNumber   Int
  marginTargetPct Decimal @default(0) @db.Decimal(5, 2)
  totalCost       Decimal @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal @default(0) @db.Decimal(12, 2)
  grossMarginPct  Decimal @default(0) @db.Decimal(5, 2)
  isCurrent       Boolean @default(true)
  isLocked        Boolean @default(false)

  // Phase 4: internal approval gate, replacing the manual/paper
  // signature process inferred in workflow-map.md. Distinct from
  // Proposal.sentAt/signedAt below, which is the client-facing side --
  // only a locked AND approved version can generate a Proposal.
  isApproved   Boolean   @default(false)
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("EstimateVersionApprover", fields: [approvedById], references: [id])

  createdAt DateTime  @default(now())
  lockedAt  DateTime?

  // Cache of the last "Run coverage analysis" result (scope-coverage-
  // service.ts) -- { generatedAt, lineItemCount, gaps: CoverageGap[] }.
  // Null until run once. Full-overwrite on every re-run, same posture as
  // Document.proposedLineItems -- an advisory, explicitly-triggered check,
  // not something that auto-invalidates when line items change (the UI
  // shows generatedAt/lineItemCount so staleness is visible, not hidden).
  coverageAnalysis Json?

  sections                EstimateSection[]
  options                 Option[]
  bidPackages             BidPackage[]
  proposals               Proposal[]
  changeOrdersAsBase      ChangeOrder[]            @relation("ChangeOrderBaseVersion")
  changeOrderAsResult     ChangeOrder?             @relation("ChangeOrderResultVersion")
  cutListParts            CutListPart[]
  cutSheets               CutSheet[]
  vendorMatchApplyLogs    VendorMatchApplyLog[]
  categoryMarginOverrides CategoryMarginOverride[]
  lineItemAuditLogs       LineItemAuditLog[]

  @@map("estimate_versions")
}

enum LineItemAuditAction {
  CREATE
  UPDATE
  DELETE
  // A line item re-created from an earlier DELETE row's own snapshot
  // (restoreLineItem, estimate-service.ts) -- distinct from a genuinely
  // new CREATE so the history reads honestly ("this is the same item
  // coming back," not "someone typed this in fresh").
  RESTORE
}

// Permanent, append-only record of every create/update/delete a person or
// the system makes to a LineItem -- there was none of this before (the
// "History" tab only ever tracked VendorMatchApplyLog, a different
// feature entirely), confirmed live as a real gap: a real production job
// had dozens of line items deleted with zero record of what was removed
// or by whom.
model LineItemAuditLog {
  id String @id @default(cuid())

  estimateVersionId String
  estimateVersion   EstimateVersion @relation(fields: [estimateVersionId], references: [id])

  // Deliberately NOT a live foreign key to LineItem -- this row must
  // survive deleteLineItem's own real hard delete untouched. A deleted
  // row's only remaining record is whatever `detail` below captured.
  lineItemId String?
  // The line item's own description at the moment of this action, so a
  // deleted or since-renamed row still reads sensibly here without a
  // live FK to resolve.
  description String

  action LineItemAuditAction
  // CREATE: a snapshot of the fields set (or, for a bulk import, a
  // { count, documentId } summary -- see addLineItemsBulk's own comment
  // on why that's one row per batch, not one per item). UPDATE: ONLY the
  // fields that actually changed, as { field: { before, after } } -- a
  // re-save with no real change writes no row at all. DELETE: a genuinely
  // full snapshot of every restorable field (see deleteLineItem's own
  // comment for the exact shape) -- including sectionId/sortOrder, which
  // is what lets restoreLineItem put the row back in the same section at
  // the same position rather than just at the bottom of wherever it's
  // dropped. RESTORE: { restoredFromAuditLogId } pointing back at the
  // DELETE row its snapshot came from.
  detail Json?

  // Null means system/import-driven -- most bulk import pipelines
  // (pricing schedules, AI proposals, vendor-match apply) have no real
  // user session behind them, and this is never fabricated to fill the
  // column. A human's own edit/delete via the UI always has one.
  actorId String?
  actor   User?   @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([estimateVersionId, createdAt])
  @@map("line_item_audit_logs")
}

model EstimateSection {
  id                String          @id @default(cuid())
  estimateVersionId String
  estimateVersion   EstimateVersion @relation(fields: [estimateVersionId], references: [id])

  name String

  // General section ordering -- for a section that's part of a booth
  // (groupLabel set below), this is specifically its H2 position among
  // its own booth's other sections (moveElementGroupOrder,
  // groupBoothLineItemsForEditing's own elementSortOrder). Deliberately
  // NOT the same field as proposalSortOrder below: an H2 group is one
  // real section row that surfaces identically in every category tab its
  // items happen to touch, not a different row per category the way a
  // booth's own presence across tabs can be, so one plain,
  // category-agnostic value is the correct model here -- see
  // proposalSortOrder's own comment for why that one has to be scoped
  // differently.
  sortOrder Int @default(0)
  sectionType SectionType

  // Groups several sections under one shared main heading (a booth /
  // exhibit instance, e.g. "Section 203 - Booth - Page 2 & 3") when a
  // pricing schedule's own "Item" column identifies one -- `name` stays
  // the sub-element within it (e.g. "Platform", "Booth Build"). Null for
  // sections that aren't part of any such group (they render standalone,
  // same as before this column existed). See pricing-import-service.ts.
  groupLabel String?

  // This booth's acquisition Method (Rental/Custom Build/Purchase) -- see
  // SectionBuildType's own comment on why this is Method-only, never a
  // stand-in for the item's Type. Null until an estimator explicitly
  // tags this booth (the Line Items tab's "Components needing a tag"
  // card); a line item's effective category
  // (resolveEffectiveCategory/bucketLineItemsByCategory) only resolves
  // Method through this once it's set -- Type always resolves
  // independently, tagged or not -- so an untagged booth's items keep
  // resolving Method per-item exactly as before, tagging is what
  // supplies it instead.
  buildType SectionBuildType?

  // Set when this section belongs to an Option (alternate) rather than
  // the base estimate -- estimateVersionId still points at the same
  // parent version either way, so locking/rollup queries share one path.
  optionId String?
  option   Option? @relation(fields: [optionId], references: [id])

  // User-approved short description, shown in place of the raw fallback
  // heading (elementTypeForSection's own unmapped case, proposal-view-
  // model.ts) wherever that fallback would otherwise appear. Null until
  // set by hand or approved from an AI suggestion below. Never applies to
  // a section whose name already resolves through ELEMENT_TYPE_MAP --
  // those keep their fixed label regardless of this field.
  description String?

  // AI-suggested description awaiting the user's approve/reject via the
  // green check / red X. Kept separate from `description` so a manually
  // typed description never goes through an approval step, and so
  // "regenerate" can freely overwrite this without touching an already-
  // approved description until the user explicitly accepts the new text.
  pendingDescription String?

  // Same description/pendingDescription pair as above, but for the booth
  // H1 heading (the raw groupLabel, e.g. "Section 428 - Booth - Page 9")
  // rather than this section's own H2. A booth has no model of its own --
  // it's just every EstimateSection sharing one groupLabel -- so these two
  // fields are kept in sync across all of them the same way buildType is
  // (updateBoothDescription/clearBoothPendingDescription use the same
  // updateMany-by-groupLabel pattern as updateSectionBuildType). Reading
  // any one section's value is always correct since they're never allowed
  // to diverge; the view layer only ever reads it off the first section
  // encountered for a given booth (groupBoothLineItemsForEditing).
  boothDescription        String?
  boothPendingDescription String?

  // Whole-group PDF visibility -- hides this section and every one of its
  // line items from the Proposal PDF regardless of each item's own
  // includeInProposal. Kept in sync across every section sharing this
  // booth's groupLabel via the same updateMany-by-groupLabel pattern as
  // buildType/boothDescription above, so toggling one booth's visibility
  // hides it everywhere it appears, not just in whichever category tab
  // the toggle was clicked from. Default true: unchanged behavior for
  // every existing section and every new one.
  includeInProposal Boolean @default(true)

  // Whole-booth "hide the detail, keep the price" -- unlike
  // includeInProposal above, this never removes the booth's cost from any
  // total (the Proposal PDF's own Grand Total, the estimate's own
  // grandTotal, everything computed from the real line items stays
  // exactly the same). It only changes what the CLIENT-FACING Proposal
  // PDF actually itemizes for this booth: just its name + total, no
  // element-type sub-headers, no line items underneath. The Line Items
  // tab (this app's own editing view) always shows full detail regardless
  // -- this flag only ever reaches proposal-pdf.tsx's rendering, never
  // the editor. Same booth-wide updateMany-by-groupLabel sync as
  // includeInProposal/buildType/boothDescription above. Added after a
  // real estimator confusion: they'd been using includeInProposal to hide
  // a booth's detail from the client, not realizing it also silently
  // dropped that booth's dollar amount from the PDF's own Grand Total.
  summarizeOnProposal Boolean @default(false)

  // Whole-booth "this isn't real client scope" -- unlike includeInProposal/
  // summarizeOnProposal above (both purely PDF-presentation concerns that
  // never touch the estimate's own numbers), this ALSO removes the
  // booth's line items from computeVersionTotals (estimate-service.ts),
  // so totalCost/grandTotal never include it either. For internal
  // reference data that happens to live inside a real client estimate
  // (a labor/freight rate comparison against another vendor, a
  // competitor-bid snapshot) -- real, useful estimating work, but not
  // something the client is being quoted for. The Line Items tab (this
  // app's own editing view) always shows it in full regardless, exactly
  // like summarizeOnProposal's own editing-view carve-out -- excluding it
  // from totals must never mean hiding it from the person who needs to
  // review, reconcile, or eventually delete it. Same booth-wide
  // updateMany-by-groupLabel sync as the flags above. Added after a real
  // production estimate ("Bid Comparison" -- Chicago labor/freight rates
  // an estimator was pricing against another vendor) turned up sitting in
  // the same version as a live client proposal, silently inflating both
  // the estimate's Grand Total and the client-facing PDF by ~$139k with
  // no indication it wasn't real scope.
  excludedFromTotals Boolean @default(false)

  // This section's position among the other booths visible within ONE
  // category, for Proposal PDF ordering -- deliberately NOT the same
  // field as sortOrder above (which orders sections generally / production
  // tracking) and deliberately NOT synced across every section sharing a
  // groupLabel the way includeInProposal/buildType are. A booth's items
  // can spread across several category tabs (LineItemsTab's own header
  // comment), each backed by a different EstimateSection row -- a single
  // shared value would let reordering booths within one category tab
  // silently reorder that same booth relative to unrelated booths in a
  // DIFFERENT category the user never saw, which is exactly the ambiguity
  // that got the Line Items tab's own old up/down section-reorder arrows
  // removed (see LineItemsTab's "Section reordering" comment). Scoping
  // this per-section keeps "move this booth within this category" a
  // well-defined, category-local operation, matching how
  // boothGroupsByCategory already builds one independent ordering per
  // category. Default 0 for every existing row (no ordering was ever
  // tracked before this field existed) -- proposal-view-model.ts falls
  // back to a stable secondary sort so a tie never reorders anything
  // visibly until someone explicitly moves a booth.
  proposalSortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems LineItem[]

  // Postgres doesn't auto-index foreign key columns the way MySQL does --
  // every estimate page load fans out from an EstimateVersion to its
  // sections via estimateVersionId, and without this it's a sequential
  // scan of the WHOLE estimate_sections table (every estimate ever
  // created, not just this one), confirmed via EXPLAIN. optionId gets the
  // same treatment for the equivalent Option -> sections fan-out.
  @@index([estimateVersionId])
  @@index([optionId])
  @@map("estimate_sections")
}

// Total = qty * unitCost for every line type -- material qty x unit cost
// or labor hours x rate share the same shape (business-rules.md Rules
// 1-2). Stored rather than computed-on-read so a section's total is a
// simple, auditable SUM.
model LineItem {
  id        String          @id @default(cuid())
  sectionId String
  section   EstimateSection @relation(fields: [sectionId], references: [id])

  lineType      LineItemType
  description   String
  department    String? // labor lines only, business-rules.md Rule 1 department codes
  // Proposal-facing grouping (Structure, Furniture, A/V, Custom Build,
  // Labor, ...) -- see line-item-category.ts for the canonical list and
  // resolution order (explicit > catalog-match > description heuristic).
  // Distinct from `department` (labor-cost-code accounting) and from
  // EstimateSection.name (production/build-tracking, stays per-booth) --
  // this field exists specifically so the client-facing PDF can group
  // and aggregate line items across the whole show the way the
  // historical hand-built proposals always did, instead of per booth.
  // Null for line items added before this field existed or where nothing
  // confidently resolved -- the PDF buckets those into "Other" at render
  // time rather than guessing a category into the database.
  category      String?
  // Order within `category`'s proposal-facing group (drag-and-drop on the
  // estimate page's category board, estimates/actions.ts's
  // reorderCategoryLineItemsAction) -- unrelated to EstimateSection's own
  // sortOrder, which orders sections/production-tracking, not line items
  // within a client-facing category. Default 0 for every existing row
  // (insertion order was never tracked before this field existed), reset
  // to a dense 0..n-1 sequence per category the first time that
  // category's board is reordered.
  sortOrder     Int               @default(0)
  // A $0.00 line is ambiguous without this -- the historical Expo CCI
  // proposals always distinguish "client already owns/supplies this" (a
  // real $0 by design) from "not yet priced" (a draft placeholder). Same
  // resolution order as category: an estimator's explicit checkbox wins,
  // otherwise inferred from the description text ("Client Owned",
  // "Existing", etc.) at import/add time -- see
  // line-item-category.ts's inferIsClientOwned.
  isClientOwned Boolean           @default(false)
  // Explicit, estimator-set disambiguation for a material that's genuinely
  // ambiguous on its own (PVC, for one) -- see LineItemUsageTag's own
  // comment. Null (unset) for every item this doesn't apply to; never
  // inferred, unlike category/isClientOwned above.
  usageTag      LineItemUsageTag?
  qty           Decimal           @db.Decimal(10, 2)
  // A real pricing schedule's Qty column is meaningless without this --
  // e.g. BOOTH_PLATFORM's "228" is only sensible once you know it's SQFT
  // (a computed L x W area, not a literal platform count). Discovered
  // missing entirely on a real job's estimate: qty rendered bare with no
  // unit anywhere, reading as obviously-wrong quantities that were
  // actually a faithful, correct parse of the source spreadsheet. Null
  // for older rows seeded before this field existed, and for manually
  // added line items where a unit wasn't given.
  unit          String?
  unitCost      Decimal           @db.Decimal(10, 2)
  totalCost     Decimal           @db.Decimal(12, 2)

  // Phase 4 design-intake prototype: a draft line item references the
  // Attachment (design pull sheet) an estimator drafted it from, and is
  // excluded from cost rollups until confirmed -- migration-plan.md's
  // "tagged draft ... human-reviewed and priced before counting."
  isDraft      Boolean     @default(false)
  attachmentId String?
  attachment   Attachment? @relation(fields: [attachmentId], references: [id])

  // Phase 7: same isDraft gate as attachmentId above, but for a line item
  // sourced from a real ingested Document (pricing-schedule import or AI
  // extraction) rather than a manually-drafted pull sheet reference.
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id])

  // Phase 7.5: the exact text this line item was pulled from -- a
  // pricing-schedule row's own cell text (verbatim, deterministic parse,
  // not AI) or an AI-proposed item's verified quote (resolved against the
  // real extracted text at commit time, same discipline as
  // Document.extractedSummary's citations). Lets a reviewer click through
  // from the line item straight to the highlighted source and check it
  // against hard data, not just trust the number. Null for a manually
  // added line item -- there's no document to check it against.
  sourceQuote      String?
  sourcePageNumber Int?

  // A vendor/RFP-assigned position or reference code for this exact row
  // (e.g. "CAM-01") when the source pricing schedule carries one -- see
  // pricing-import-service.ts's Ref.-column capture. This is the shared
  // key across two independently-authored documents: a client RFP names
  // this row "Right Endzone Camera Platform" while the client's own
  // filled-in submission (or a sub-vendor's quote) may reference it only
  // as "CAM-01" -- text-similarity matching alone can never bridge that,
  // but an exact code match can. vendor-match-ai-service.ts matches this
  // deterministically against VendorQuoteLine.unitCode before ever
  // asking the AI to guess. Null for imports/rows with no such code.
  positionCode String?

  // Null (the default, unchanged behavior for every row that predates
  // this column) means "in-house / not yet decided" -- estimated
  // internally rather than sent out for a vendor to price. Set once a
  // user groups this item into a BidPackage (freeform, cross-category --
  // a real vendor package like a scaffolding/rigging bid routinely spans
  // Structure, Flooring, and Labor line items at once, so this is
  // intentionally not scoped to one EstimateSection). One package per
  // item, not a join table -- matches how freeform selection actually
  // works (an item is either being bid out as part of this package or it
  // isn't) and keeps un-assigning a single `bidPackageId: null` write.
  bidPackageId String?
  bidPackage   BidPackage? @relation(fields: [bidPackageId], references: [id])

  // Per-item PDF visibility, independent of category/isClientOwned/isDraft
  // -- an estimator can carry a line internally (cost tracking, a note to
  // self) without it ever reaching the client-facing Proposal PDF. Default
  // true: every existing row, and every new one, appears in the proposal
  // unless someone explicitly hides it. A hidden EstimateSection hides all
  // its items regardless of this flag -- see EstimateSection.includeInProposal.
  includeInProposal Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  costActuals          CostActual[]
  cutListParts         CutListPart[]
  vendorMatchApplyLogs VendorMatchApplyLog[]

  // Same reasoning as EstimateSection.estimateVersionId above -- this is
  // the largest, hottest table in the schema (every line item across
  // every estimate), and every one of these foreign keys is filtered on
  // by a real query path: sectionId on every estimate page load,
  // bidPackageId when rendering a bid package's items, documentId/
  // attachmentId when resolving a draft's source. None of them had an
  // index; confirmed via EXPLAIN that a plain sectionId lookup was a
  // sequential scan of the whole table.
  @@index([sectionId])
  @@index([bidPackageId])
  @@index([documentId])
  @@index([attachmentId])
  @@map("line_items")
}

// Cut-list phase 0 (see docs/... cut-list-service.ts) -- one row per
// physical part to be cut from raw stock, the input to the phase 2
// nesting engine. Deliberately its own model, not a LineItem field:
// LineItem is a costing row (qty/unit/cost) already serving the
// proposal/PDF pipeline, and most LineItems (labor, rentals, services)
// have no cut-list meaning at all. A cut list is fabrication data for
// the shop floor, priced work is what LineItem already tracks -- a part
// optionally points back at the LineItem it's costed under, but doesn't
// replace it.
model CutListPart {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id])

  description String
  qty         Int      @default(1)
  // Inches, same convention as Material's stock fields above. width is
  // meaningless (left null) for a LINEAR material's part -- only length
  // (cut-to-length) applies; a SHEET material's part uses both.
  width       Decimal? @db.Decimal(8, 3)
  length      Decimal  @db.Decimal(8, 3)
  // Overrides the material's own thickness only when this specific part
  // genuinely differs (e.g. a doubled-up panel) -- null means "use
  // material.thickness," the common case, not "no thickness."
  thickness   Decimal? @db.Decimal(8, 3)

  // Inherited from Material.grainDirectionMatters by default at entry
  // time, but a per-part override -- some parts from a grain-constrained
  // sheet (an edge piece, a hidden brace) genuinely don't care about
  // orientation even though most of that sheet's parts do.
  grainConstrained Boolean @default(false)
  // Free text for now (e.g. "top,bottom") -- same posture as
  // Material.category before it got a real taxonomy; not load-bearing
  // for phase 0/1, just carried through so phase 2+ doesn't need a
  // migration to start using it.
  edgeBanding      String?

  sortOrder Int @default(0)

  estimateVersionId String
  estimateVersion   EstimateVersion @relation(fields: [estimateVersionId], references: [id])

  // Optional -- ties this part back to the specific priced LineItem it's
  // fabrication detail for (e.g. a "Custom reception counter" line),
  // when one exists. Null for a cut list entered before -- or without --
  // a matching priced line.
  lineItemId String?
  lineItem   LineItem? @relation(fields: [lineItemId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("cut_list_parts")
}

// Cut-list phase 2 (cut-list-nesting-service.ts): one row per sheet/board
// a material's nesting run actually used, holding the packed layout
// (placed-part positions) as JSON -- same full-overwrite-on-re-run
// posture as Document.proposedLineItems/EstimateVersion.coverageAnalysis
// elsewhere in this schema, not something that incrementally patches.
// Scoped to (estimateVersionId, materialId): a version's different
// materials never share a sheet, so they're optimized (and stored)
// independently, one CutSheet set per material.
model CutSheet {
  id                String          @id @default(cuid())
  estimateVersionId String
  estimateVersion   EstimateVersion @relation(fields: [estimateVersionId], references: [id])
  materialId        String
  material          Material        @relation(fields: [materialId], references: [id])

  sheetNumber Int
  // PlacedPart[] (cut-list-nesting-service.ts): { cutListPartId, x, y,
  // width, height, rotated } per instance actually placed on this sheet
  // -- width/height are the AS-PLACED dimensions (post any rotation),
  // not the part's originally entered width/length, so a renderer
  // (phase 3) can draw straight from this without re-deriving
  // orientation itself.
  layout      Json

  // Phase 5: set when this sheet was actually cut from an existing
  // remnant instead of fresh full-size stock -- null for an ordinary
  // fresh sheet. That remnant's OWN width/length (not the material's
  // full stockWidth/stockLength) is this sheet's real usable area; the
  // diagram/DXF renderers must draw against that, not the material's
  // nominal stock size, or a shop-floor cut is made against the wrong
  // assumed sheet size.
  consumedRemnantId String?          @unique
  consumedRemnant   MaterialRemnant? @relation("ConsumedRemnant", fields: [consumedRemnantId], references: [id])
  // Back-relation only (FK lives on MaterialRemnant.generatedByCutSheetId)
  // -- the single largest leftover free rectangle from this sheet's own
  // packing run, if any, above the practical minimum size to bother
  // tracking. Deleted alongside this CutSheet on re-optimize (see
  // optimizeNestingForMaterial), not left as a stale orphan.
  generatedRemnant  MaterialRemnant? @relation("GeneratedRemnant")

  // Cut-list phase 8: survives re-optimize untouched (see
  // clearStaleCutSheets) -- CutList Plus's "pinned diagrams." A locked
  // sheet also always renders read-only (CutSheetDiagram, not the drag
  // editor), same as a locked EstimateVersion -- "locked" means
  // "finalized," not "protected from the optimizer but still draggable."
  locked Boolean   @default(false)
  // Shop-floor confirmation this sheet was physically cut -- a
  // production action, deliberately NOT gated by EstimateVersion.isLocked
  // the way every other cut-list mutation is: cutting happens BECAUSE an
  // estimate is locked/accepted, gating it the same way would be
  // backwards.
  cutAt  DateTime?

  createdAt DateTime @default(now())

  @@map("cut_sheets")
}

// Phase 5: shop-wide (NOT job/EstimateVersion-scoped) reusable leftover
// stock from a completed nesting run -- matches real shop practice (a
// cutoff bin any future job can draw from) and the real CutList Plus
// export this feature is grounded in, which has an "Off-Cut" policy
// flag per material stock row, not per job. Only the single largest
// free rectangle per sheet is ever tracked -- maxrects-packer's
// freeRects can report multiple OVERLAPPING candidate regions for the
// same leftover space (confirmed live before this was built), so
// persisting more than one per sheet would risk double-booking the same
// physical scrap as two different "available" remnants.
model MaterialRemnant {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  width      Decimal  @db.Decimal(8, 3)
  length     Decimal  @db.Decimal(8, 3)

  // Deleted (not orphaned) when this CutSheet is deleted on a
  // re-optimize -- otherwise every re-run piles up duplicate stale
  // remnants describing a layout that no longer exists.
  generatedByCutSheetId String   @unique
  generatedByCutSheet   CutSheet @relation("GeneratedRemnant", fields: [generatedByCutSheetId], references: [id])

  consumedAt DateTime?
  // Cleared (remnant given back as available), not deleted, when the
  // consuming CutSheet is deleted on a re-optimize.
  consumedBy CutSheet? @relation("ConsumedRemnant")

  createdAt DateTime @default(now())

  @@map("material_remnants")
}

// ---------------------------------------------------------------------
// Phase 4: proposal & approval workflow (docs/migration-plan.md).
//
// Deliberately NOT built this phase: a multi-year Contract concept --
// surfaced by Poly Coat's real 3-year deal (Phase 1), where Year 1 builds
// assets and Years 2-3 re-rent them at far higher margin. Same call as
// PRICE OPTIONS in Phase 3: no second real multi-year job exists yet to
// validate a Contract model against. Revisit if another one shows up.
//
// ChangeOrder references Estimate directly rather than Project --
// data-model-v0.md's "optionally references the originating Estimate"
// fallback, since Project doesn't exist yet (Phase 5).
//
// Attachment is scoped to Estimate only this phase (not the full
// Estimate/Project/WorkOrder/ChangeOrder polymorphic association
// data-model-v0.md describes) -- Project/WorkOrder don't exist yet, and
// ChangeOrder attachments weren't part of this phase's explicit scope.
// ---------------------------------------------------------------------

model ProposalTemplate {
  id             String @id @default(cuid())
  name           String
  brandingConfig Json?
  layoutConfig   Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  proposals Proposal[]

  @@map("proposal_templates")
}

// Immutable once sent (sentAt locks it), mirroring EstimateVersion's
// isLocked pattern. templateConfigSnapshot freezes the template's
// branding/layout at send time so a later template edit doesn't
// retroactively change how an already-sent proposal renders
// (data-model-v0.md's Proposal versioning note). Only a locked AND
// approved EstimateVersion can generate a Proposal -- see
// proposal-service.ts.
model Proposal {
  id                String           @id @default(cuid())
  estimateVersionId String
  estimateVersion   EstimateVersion  @relation(fields: [estimateVersionId], references: [id])
  templateId        String
  template          ProposalTemplate @relation(fields: [templateId], references: [id])

  templateConfigSnapshot Json?
  sentAt                 DateTime?
  signedAt               DateTime?
  // A typed-name attestation, not a real e-signature (DocuSign/HelloSign-
  // class integration needs a vendor account -- see README's backlog note).
  // Captured at sign time so "who marked this signed" isn't lost the way
  // signedAt alone leaves it.
  signedByName           String?
  signedByTitle          String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("proposals")
}

// An alternate/upgrade pricing path within one estimate (e.g. "Option 3:
// upgraded flooring") -- direct port of the OPTION sheet pattern
// (business-rules.md/data-model-v0.md), structurally identical to a
// COMPONENT sheet. Reuses EstimateSection/LineItem rather than a
// parallel model: a section belongs to an Option via
// EstimateSection.optionId instead of duplicating the section/line-item
// shape. Immutable once its parent EstimateVersion is locked, same rule
// as base sections (estimate-service.ts's assertUnlocked).
model Option {
  id                String          @id @default(cuid())
  estimateVersionId String
  estimateVersion   EstimateVersion @relation(fields: [estimateVersionId], references: [id])

  name      String
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections EstimateSection[]

  @@map("options")
}

enum BidPackageStatus {
  AWAITING_QUOTE
  QUOTE_RECEIVED
  REVIEWED
}

// Extract prices / Re-extract runs a real ~30-100+ second AI call
// (extraction, then a holistic match pass) backgrounded via next/server's
// after() so the Server Action itself returns fast -- this is what the
// client-side progress poller reads to show real phase text instead of a
// static "Extracting..." label the whole time. IDLE is the never-run /
// steady-state-after-COMPLETE-was-observed value; COMPLETE and FAILED are
// both terminal (the poller stops on either).
enum VendorExtractionPhase {
  IDLE
  READING_DOCUMENT
  EXTRACTING_LINES
  MATCHING
  COMPLETE
  FAILED
}

// A user-defined, freeform cross-category subset of one EstimateVersion's
// LineItems sent out to a single vendor for pricing -- NOT a pricing
// alternate like Option above (same {id, estimateVersionId, name} shape,
// but this groups EXISTING line items for procurement, never creates new
// sections/totals of its own). v1 is one vendor quote per package (see
// LineItem.bidPackageId and Document.bidPackageId below) -- multi-vendor
// comparison is a plausible fast-follow but isn't built yet, so don't
// assume a package's documents list is meant to hold more than one
// VENDOR_QUOTE document today even though nothing here enforces that.
model BidPackage {
  id                String          @id @default(cuid())
  estimateVersionId String
  estimateVersion   EstimateVersion @relation(fields: [estimateVersionId], references: [id])

  name       String
  vendorName String?
  status     BidPackageStatus @default(AWAITING_QUOTE)

  // See VendorExtractionPhase's own comment -- tracks the backgrounded
  // Extract-prices/Re-extract run so the client can poll real progress
  // instead of blocking on one long request. matchResult is the AI match
  // service's persisted output (see vendor-match-ai-service.ts), read
  // directly at render time instead of recomputed live on every request.
  vendorExtractionPhase     VendorExtractionPhase @default(IDLE)
  vendorExtractionStartedAt DateTime?
  vendorExtractionError     String?
  matchResult               Json?
  // Sections matchVendorQuoteLinesWithAi judged worth creating -- a
  // vendor grouping that reads as a real cost category (e.g. "One Time
  // Service Costs"), not an opaque positional code (e.g. "CAM-06"), with
  // nothing on the estimate corresponding to it yet. A separate field
  // from matchResult (not folded into it) so existing extracted data
  // never needs a shape migration -- see vendor-match-ai-service.ts's
  // own header comment. Kept only for entries not yet committed or
  // dismissed (see bid-package-actions.ts's commit/dismiss actions).
  proposedSections          Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  lineItems LineItem[]
  documents Document[]
  applyLogs VendorMatchApplyLog[]

  @@map("bid_packages")
}

// A durable, point-in-time record of every vendor-match "apply" event --
// BidPackage.matchResult (see its own comment) only ever holds CURRENT
// state, so once a reviewer applied a match there was previously no way
// to see what was actually written, by whom, or when, short of trusting
// a reasoning string that a later Re-extract could overwrite. One row
// per apply click (single row, a bulk group, "all high-confidence," or a
// hand-picked "selected" checkbox submission -- see `method`).
//
// Every meaningful fact is snapshotted directly on the row (target/
// vendor-line descriptions, dollar amounts, document filename), not just
// derived from live relations, so the record stays legible even after
// the LineItem it priced is later deleted (a real, already-seen case --
// see the stale-match self-healing this session's own work added to
// bid-package-actions.ts) or the BidPackage/Document is removed.
// lineItemId/bidPackageId/documentId are therefore all optional with
// implicit ON DELETE SET NULL, same posture AiUsageEvent already takes
// toward Document/Opportunity -- the log row itself is never deleted
// just because something it once pointed at was.
model VendorMatchApplyLog {
  id String @id @default(cuid())

  estimateVersionId String
  estimateVersion   EstimateVersion @relation(fields: [estimateVersionId], references: [id])

  bidPackageId   String?
  bidPackage     BidPackage? @relation(fields: [bidPackageId], references: [id])
  bidPackageName String

  lineItemId         String?
  lineItem           LineItem? @relation(fields: [lineItemId], references: [id])
  targetDescription  String
  targetSectionLabel String?

  // The vendor line(s) that rolled up into this one apply -- count > 1
  // means several vendor lines were summed onto one target (a bulk group
  // or a multi-row "selected" apply), matching applyMatchesByIndices's
  // own grouping in bid-package-actions.ts.
  vendorLineDescriptions String
  vendorLineCount        Int
  qty                    Decimal @db.Decimal(10, 2)
  unitCost               Decimal @db.Decimal(10, 2)
  totalCost              Decimal @db.Decimal(12, 2)
  confidence             String?

  documentId       String?
  document         Document? @relation(fields: [documentId], references: [id])
  documentFilename String

  // Which UI action produced this apply -- "single" | "group" |
  // "all_high_confidence" | "selected". A real audit trail's own
  // question is as much "was this reviewed one at a time or trusted in
  // bulk?" as it is "what changed."
  method String

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([estimateVersionId])
  @@index([bidPackageId])
  @@index([createdAt])
  @@map("vendor_match_apply_logs")
}

enum ChangeOrderStatus {
  DRAFT
  APPROVED
  REJECTED
}

// Stored as two full EstimateVersion snapshots (base + result) rather
// than an explicit delta table -- reuses the versioning/locking machinery
// already built for EstimateVersion instead of inventing a parallel
// storage shape. The "diff" data-model-v0.md recommends for reporting
// clarity is computed on read by comparing baseVersion's line items
// against resultVersion's (see change-order-service.ts) -- an
// intentional divergence from the workbook, which authors each change
// order as an independent from-scratch mini-estimate rather than a diff.
model ChangeOrder {
  id         String   @id @default(cuid())
  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id])

  baseVersionId   String
  baseVersion     EstimateVersion @relation("ChangeOrderBaseVersion", fields: [baseVersionId], references: [id])
  resultVersionId String          @unique
  resultVersion   EstimateVersion @relation("ChangeOrderResultVersion", fields: [resultVersionId], references: [id])

  description String
  status      ChangeOrderStatus @default(DRAFT)

  createdAt  DateTime  @default(now())
  approvedAt DateTime?

  @@map("change_orders")
}

// business-rules.md/data-model-v0.md's Attachment: fileRef is a text
// reference (filename, or an external FTP/WeTransfer link), not an
// uploaded file -- the workbook's own evidence (WORK ORDER!C15) confirms
// artwork already moves outside the workbook entirely via external file
// transfer, so this is a pointer, not a storage pipeline. Minimal
// design-intake prototype only, per explicit decision: no automated
// pull-sheet table extraction this phase.
model Attachment {
  id         String   @id @default(cuid())
  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id])

  fileRef      String
  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  draftLineItems LineItem[]

  @@map("attachments")
}

// ---------------------------------------------------------------------
// Phase 5: project, production & logistics tracking (docs/migration-plan.md).
//
// A Project is created via "Convert to Project" from a WON Opportunity --
// mirrors Phase 2's "Convert to estimate" pattern. Project has no direct
// FK to Estimate/EstimateVersion (data-model-v0.md's "has one approved
// Estimate" is already reachable via the shared Opportunity -- both
// Project and Estimate belong to Opportunity, so adding a second direct
// link would just be a redundant path to the same data).
//
// ChangeOrder deliberately still references Estimate, not Project --
// explicit decision this phase: moving it would be schema churn with no
// functional benefit, since ChangeOrder's diff logic only ever touches
// EstimateVersion data. Revisit if Project ever needs to list its change
// orders directly.
//
// Vendor + purchasing is scoped minimally: a Vendor catalog plus an
// optional Task.vendorId link for procurement tasks -- data-model-v0.md
// mentions "WorkOrder purchasing lines" but doesn't concretely define
// that entity, and the workbook has zero vendor/purchasing precedent to
// migrate from, so a full PurchaseOrder/PurchaseLine model would be
// speculative rather than grounded in either source.
// ---------------------------------------------------------------------

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETE
  CANCELLED
}

model Project {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  jobNumber     String? // workbook source: Start Page!B14 "JOB #"
  status        ProjectStatus @default(ACTIVE)
  showStartDate DateTime?
  showEndDate   DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workOrders WorkOrder[]

  @@map("projects")
}

enum WorkOrderStatus {
  DRAFT
  IN_PRODUCTION
  READY_TO_SHIP
  INSTALLED
  COMPLETE
}

// Timeline as trackable dates, not the workbook's static text --
// docs/workflow-map.md's clearest workflow evidence (explicit timeline
// labels): deposit -> production meeting -> artwork deadline -> balance
// due -> installation.
model WorkOrder {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  status WorkOrderStatus @default(DRAFT)

  depositDueDate        DateTime?
  productionMeetingDate DateTime?
  artworkDeadlineDate   DateTime?
  balanceDueDate        DateTime?
  installDate           DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tasks     Task[]
  shipments Shipment[]

  @@map("work_orders")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

// task_type maps to business-rules.md Rule 1's department codes (DE, EF,
// ...) or Rule 3's five special slots (DESIGN TIME, ENGINEERING,
// ESTIMATING, PRESET, PACKING) -- free text, same pattern as
// LineItem.department, rather than a rigid enum, since both code sets
// already exist as data (LaborRate.departmentCode) or workbook-derived
// labels, not a fixed ForgeOS-defined list.
model Task {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])

  description    String
  departmentCode String?
  status         TaskStatus @default(TODO)
  dueDate        DateTime?

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  costActuals CostActual[]

  @@map("tasks")
}

enum ShipmentStatus {
  PLANNED
  SHIPPED
  DELIVERED
}

// Self-contained ForgeOS record replacing the workbook's TRUCKING & LOAD
// LIST sheet, whose own data depends on a broken external link
// (dependency-map.md Sec.4) -- loadListNote is a free-text reference,
// same minimalism as Attachment.fileRef, not a structured line-item
// model the workbook gives no real precedent for.
model Shipment {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id])

  carrier      String?
  loadListNote String?
  shipDate     DateTime?
  trackingRef  String?
  status       ShipmentStatus @default(PLANNED)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("shipments")
}

// Pure net-new capability -- data-model-v0.md: "no vendor/supplier table
// exists anywhere in the 95 sheets." Not a migration of workbook data.
model Vendor {
  id          String  @id @default(cuid())
  name        String
  contactInfo String?
  category    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tasks Task[]

  @@map("vendors")
}

// ---------------------------------------------------------------------
// Phase 6: actual-cost reporting (docs/migration-plan.md). AI-assisted
// estimating and risk detection are deliberately NOT built this phase --
// migration-plan.md's own Phase 6 scope gates them on "sufficient
// EstimateVersion + CostActual history accumulated in ForgeOS itself,"
// which doesn't exist yet (ForgeOS has no real production usage history
// at the time this phase was built). Same reasoning as skipping PRICE
// OPTIONS/the multi-year Contract concept: no real data to validate
// against, so building on synthetic data would violate this project's
// real-data-driven testing philosophy rather than serve it.
// ---------------------------------------------------------------------

// Formalizes Price Summary!E6/F6's "ESTIMATED COST"/"ACTUAL INCURRED"
// header pair (data-model-v0.md's CostActual) -- a concept the workbook
// names but never populates with real structured data. References
// LineItem and/or Task (at least one, enforced at the service layer, not
// the DB -- same minimalism as Attachment's owner reference). Append-only
// by design (data-model-v0.md: "Versioning: append-only") -- no update or
// delete; a correction is a new entry, not an edit to history.
model CostActual {
  id String @id @default(cuid())

  lineItemId String?
  lineItem   LineItem? @relation(fields: [lineItemId], references: [id])

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id])

  actualCost Decimal @db.Decimal(12, 2)
  source     String?

  recordedById String?
  recordedBy   User?    @relation(fields: [recordedById], references: [id])
  recordedAt   DateTime @default(now())

  @@map("cost_actuals")
}

// B23: append-only record of the admin/user-management actions in
// admin/users/actions.ts that change who can access ForgeOS or what they
// can do in it (create, role change, deactivate, reactivate) -- the kind
// of thing that needs a "who did this and when" trail even though nobody
// is disputing an estimate. Same append-only reasoning as CostActual: a
// correction is a new row, not an edit to history.
model AdminAuditLog {
  id String @id @default(cuid())

  action String // e.g. "user.create", "user.role_change", "user.deactivate", "user.reactivate"
  detail String? // human-readable summary, e.g. "role changed from EMPLOYEE to ADMIN"

  actorId String
  actor   User   @relation("AdminAuditLogActor", fields: [actorId], references: [id])

  targetUserId String?
  targetUser   User?   @relation("AdminAuditLogTarget", fields: [targetUserId], references: [id])

  createdAt DateTime @default(now())

  @@map("admin_audit_logs")
}

// Phase 7.3: one thread per Opportunity (not Project) -- documents and
// the AI's context are Opportunity-scoped throughout Phase 7, since RFP
// ingestion happens pre-estimate, before a Project can exist. "Chat with
// a project" in casual usage means this thread, not literal Project
// model data (WorkOrder/Task/Shipment aren't in its context).
model ChatThread {
  id            String      @id @default(cuid())
  opportunityId String      @unique
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  createdAt DateTime @default(now())

  messages ChatMessage[]

  @@map("chat_threads")
}

model ChatMessage {
  id       String     @id @default(cuid())
  threadId String
  thread   ChatThread @relation(fields: [threadId], references: [id])

  role    String // "user" | "assistant"
  content String @db.Text

  createdAt DateTime @default(now())

  @@map("chat_messages")
}

// Cut-list phase 7: shop-wide defaults for the nesting engine and the
// diagram editor, editable from a single settings panel instead of
// living as hardcoded constants or only per-material overrides. A true
// singleton -- exactly one row should ever exist; getCutListSettings()
// (cut-list-settings-service.ts) lazily creates it with these column
// defaults on first read, so no manual seed step is required. Column
// defaults match what was already hardcoded before this model existed,
// so nothing changes behaviorally until someone actually edits the panel.
model CutListSettings {
  id String @id @default(cuid())

  // Fallback ONLY -- Material.defaultKerf (per-material, already
  // editable on that material's own catalog page) always wins when set.
  // This is what a material falls back to until it has its own real
  // value (a newly added material, or one without machine specs yet).
  defaultKerf Decimal @default(0.125) @db.Decimal(6, 3)

  // Below this in either dimension, a leftover scrap isn't tracked as
  // reusable stock (see cut-list-nesting-service.ts's
  // extractLargestRemnantCandidate) -- how small a piece is worth
  // keeping is a real shop policy call, not a fixed constant.
  minRemnantDimension Decimal @default(6) @db.Decimal(6, 3)

  // Grid snap for the drag-to-reposition diagram editor
  // (cut-sheet-diagram-editor.tsx) -- fine enough to place a part
  // precisely, coarse enough a shop worker isn't chasing hundredths of
  // an inch; different shops cut to different tolerances.
  dragGridSnap Decimal @default(0.25) @db.Decimal(6, 3)

  updatedAt DateTime @updatedAt

  @@map("cut_list_settings")
}

// Postgres-backed rate limiter state -- replaces the old in-memory Map
// (rate-limit.ts), which only worked because the app ran as a single
// always-on process. Serverless invocations are effectively multi-instance,
// so the bucket has to live somewhere shared. Expired rows are simply
// overwritten by the next upsert; no separate cleanup job needed at this
// table's expected size.
model RateLimitBucket {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime

  @@map("rate_limit_buckets")
}
