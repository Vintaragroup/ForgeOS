// ForgeOS — Phase 2 schema: CRM & opportunity shell.
//
// Scoped to exactly what docs/migration-plan.md Phase 2 needs: Company,
// Contact, Opportunity, User, and a stub Estimate (identity fields only —
// real estimate math is Phase 3). See docs/data-model-v0.md for the full
// entity catalog this is drawn from.
//
// Deliberately single-tenant: no tenant_id anywhere. ForgeOS was scoped as
// an internal tool for one fabrication company, not a multi-tenant SaaS
// product, so docs/data-model-v0.md's "tenant-scoped" language on each
// entity does not apply here.
//
// AuditEvent (the universal audit log in data-model-v0.md) is out of scope
// for Phase 2. Only the one audit requirement Phase 2 explicitly calls for
// -- Opportunity stage-change history, for sales reporting -- is modeled,
// via StageChangeEvent below.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: `url` is no longer valid here. The CLI/Migrate connection
// string lives in prisma.config.ts; the runtime client gets its
// connection via a driver adapter (@prisma/adapter-pg) constructed in
// src/lib/db.ts.
datasource db {
  provider = "postgresql"
}

enum ContactRole {
  CLIENT_CONTACT
  ACCOUNT_EXECUTIVE
}

enum OpportunityStage {
  NEW
  CONTACTED
  QUALIFIED
  ESTIMATING
  WON
  LOST
}

enum EstimateStatus {
  DRAFT
  IN_PROGRESS
}

model User {
  id         String  @id @default(cuid())
  name       String
  email      String  @unique
  role       String?
  department String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  contactLinks  Contact[]     @relation("UserContact")
  opportunities Opportunity[] @relation("OpportunityOwner")

  approvedEstimateVersions EstimateVersion[] @relation("EstimateVersionApprover")
  uploadedAttachments      Attachment[]

  @@map("users")
}

model Company {
  id             String  @id @default(cuid())
  name           String
  billingAddress String?
  industry       String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  contacts      Contact[]
  opportunities Opportunity[]

  @@map("companies")
}

// A Contact is either a client_contact (belongs to a Company) or an
// account_executive (linked back to an internal User) -- see
// docs/data-model-v0.md's Contact entity. Both cases share this table
// rather than being split, matching how the workbook treated them (one
// "contact directory" concept, DATA!B24:F33, regardless of which side of
// the deal the person is on).
model Contact {
  id    String      @id @default(cuid())
  name  String
  email String?
  phone String?
  role  ContactRole

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  userId String? // set when role = ACCOUNT_EXECUTIVE and linked to an internal User
  user   User?   @relation("UserContact", fields: [userId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  opportunitiesAsPrimary Opportunity[] @relation("OpportunityPrimaryContact")

  @@map("contacts")
}

model Opportunity {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  primaryContactId String?
  primaryContact   Contact? @relation("OpportunityPrimaryContact", fields: [primaryContactId], references: [id])

  ownerId String?
  owner   User?   @relation("OpportunityOwner", fields: [ownerId], references: [id])

  showName      String
  boothNumber   String?
  targetMoveIn  DateTime?
  targetMoveOut DateTime?
  stage         OpportunityStage @default(NEW)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  stageEvents StageChangeEvent[]
  estimates   Estimate[]

  @@map("opportunities")
}

model StageChangeEvent {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  fromStage OpportunityStage?
  toStage   OpportunityStage
  note      String?
  changedAt DateTime          @default(now())

  @@map("opportunity_stage_events")
}

// Identity + status only. All pricing detail lives on EstimateVersion --
// see data-model-v0.md's Estimate entity: "the single most important
// structural correction ForgeOS must make relative to the workbook,
// which has no version concept at all."
model Estimate {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])

  budget  Decimal?       @db.Decimal(12, 2)
  taxCity String?
  status  EstimateStatus @default(DRAFT)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  versions     EstimateVersion[]
  changeOrders ChangeOrder[]
  attachments  Attachment[]

  @@map("estimates")
}

// ---------------------------------------------------------------------
// Phase 3: native estimate engine (docs/migration-plan.md).
//
// Deliberately NOT ported this phase: PRICE OPTIONS' margin-tier logic
// (business-rules.md Rule 7) -- its 43/57...65/35 tiers and x1.075
// multiplier have no confirmed business meaning even after the sheet was
// proven mechanically repairable in Phase 1. The engine below implements
// only Price Summary's gross-up formula (Rule 6), the mechanism actually
// confirmed to produce real client-facing totals (Yoku Moku, Booksy).
//
// Option (alternates, one full EstimateSection set per OPTION sheet) is
// also deferred -- not built this phase. Noted, not silently dropped.
// ---------------------------------------------------------------------

enum LaborRateType {
  DEPARTMENT
  CITY_MARKET
}

// Unifies business-rules.md Rule 1 (15 department rates, hardcoded on
// COMPONENT 1 and fanned out by formula to 43 sibling sheets) and Rule 10
// (a city rate table with zero formula consumers anywhere in the
// workbook) into one catalog with a rate_type discriminator -- exactly
// the remediation data-model-v0.md's LaborRate entity proposed.
model LaborRate {
  id             String        @id @default(cuid())
  rateType       LaborRateType
  departmentCode String? // e.g. "DE", "EN" -- business-rules.md Rule 1's 15 codes
  departmentName String?
  city           String?
  rate           Decimal       @db.Decimal(10, 2)
  effectiveDate  DateTime      @default(now())

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("labor_rates")
}

model Material {
  id              String  @id @default(cuid())
  name            String
  unit            String?
  currentUnitCost Decimal @db.Decimal(10, 2)
  category        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("materials")
}

// business-rules.md Rule 9: Standard Cost Sheet's flat rental prices,
// including one embedded-derivation formula ("=(35*2)*1.25") -- carried
// forward here as priceDerivationNote so the reasoning isn't lost the
// way it was in the original workbook.
model RentalItem {
  id                  String  @id @default(cuid())
  name                String
  unitPrice           Decimal @db.Decimal(10, 2)
  priceDerivationNote String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("rental_items")
}

enum SectionType {
  COMPONENT
  CATEGORY
  FEE
}

enum LineItemType {
  MATERIAL
  LABOR
  FEE
}

// Immutable once locked -- the structural fix for the workbook's total
// lack of version history (docs/workflow-map.md's "Key finding").
// isCurrent marks which version is the active one for its Estimate;
// isLocked marks whether it can still be edited. "Create new version"
// duplicates a locked version's sections/line items into a fresh,
// unlocked one rather than mutating history.
model EstimateVersion {
  id         String   @id @default(cuid())
  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id])

  versionNumber   Int
  marginTargetPct Decimal @default(0) @db.Decimal(5, 2)
  totalCost       Decimal @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal @default(0) @db.Decimal(12, 2)
  grossMarginPct  Decimal @default(0) @db.Decimal(5, 2)
  isCurrent       Boolean @default(true)
  isLocked        Boolean @default(false)

  // Phase 4: internal approval gate, replacing the manual/paper
  // signature process inferred in workflow-map.md. Distinct from
  // Proposal.sentAt/signedAt below, which is the client-facing side --
  // only a locked AND approved version can generate a Proposal.
  isApproved   Boolean   @default(false)
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?     @relation("EstimateVersionApprover", fields: [approvedById], references: [id])

  createdAt DateTime  @default(now())
  lockedAt  DateTime?

  sections            EstimateSection[]
  options             Option[]
  proposals           Proposal[]
  changeOrdersAsBase  ChangeOrder[]     @relation("ChangeOrderBaseVersion")
  changeOrderAsResult ChangeOrder?      @relation("ChangeOrderResultVersion")

  @@map("estimate_versions")
}

model EstimateSection {
  id                String          @id @default(cuid())
  estimateVersionId String
  estimateVersion   EstimateVersion @relation(fields: [estimateVersionId], references: [id])

  name        String
  sortOrder   Int         @default(0)
  sectionType SectionType

  // Set when this section belongs to an Option (alternate) rather than
  // the base estimate -- estimateVersionId still points at the same
  // parent version either way, so locking/rollup queries share one path.
  optionId String?
  option   Option? @relation(fields: [optionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems LineItem[]

  @@map("estimate_sections")
}

// Total = qty * unitCost for every line type -- material qty x unit cost
// or labor hours x rate share the same shape (business-rules.md Rules
// 1-2). Stored rather than computed-on-read so a section's total is a
// simple, auditable SUM.
model LineItem {
  id        String          @id @default(cuid())
  sectionId String
  section   EstimateSection @relation(fields: [sectionId], references: [id])

  lineType    LineItemType
  description String
  department  String? // labor lines only, business-rules.md Rule 1 department codes
  qty         Decimal      @db.Decimal(10, 2)
  unitCost    Decimal      @db.Decimal(10, 2)
  totalCost   Decimal      @db.Decimal(12, 2)

  // Phase 4 design-intake prototype: a draft line item references the
  // Attachment (design pull sheet) an estimator drafted it from, and is
  // excluded from cost rollups until confirmed -- migration-plan.md's
  // "tagged draft ... human-reviewed and priced before counting."
  isDraft      Boolean     @default(false)
  attachmentId String?
  attachment   Attachment? @relation(fields: [attachmentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("line_items")
}

// ---------------------------------------------------------------------
// Phase 4: proposal & approval workflow (docs/migration-plan.md).
//
// Deliberately NOT built this phase: a multi-year Contract concept --
// surfaced by Poly Coat's real 3-year deal (Phase 1), where Year 1 builds
// assets and Years 2-3 re-rent them at far higher margin. Same call as
// PRICE OPTIONS in Phase 3: no second real multi-year job exists yet to
// validate a Contract model against. Revisit if another one shows up.
//
// ChangeOrder references Estimate directly rather than Project --
// data-model-v0.md's "optionally references the originating Estimate"
// fallback, since Project doesn't exist yet (Phase 5).
//
// Attachment is scoped to Estimate only this phase (not the full
// Estimate/Project/WorkOrder/ChangeOrder polymorphic association
// data-model-v0.md describes) -- Project/WorkOrder don't exist yet, and
// ChangeOrder attachments weren't part of this phase's explicit scope.
// ---------------------------------------------------------------------

model ProposalTemplate {
  id             String @id @default(cuid())
  name           String
  brandingConfig Json?
  layoutConfig   Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  proposals Proposal[]

  @@map("proposal_templates")
}

// Immutable once sent (sentAt locks it), mirroring EstimateVersion's
// isLocked pattern. templateConfigSnapshot freezes the template's
// branding/layout at send time so a later template edit doesn't
// retroactively change how an already-sent proposal renders
// (data-model-v0.md's Proposal versioning note). Only a locked AND
// approved EstimateVersion can generate a Proposal -- see
// proposal-service.ts.
model Proposal {
  id                String           @id @default(cuid())
  estimateVersionId String
  estimateVersion   EstimateVersion  @relation(fields: [estimateVersionId], references: [id])
  templateId        String
  template          ProposalTemplate @relation(fields: [templateId], references: [id])

  templateConfigSnapshot Json?
  sentAt                 DateTime?
  signedAt               DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("proposals")
}

// An alternate/upgrade pricing path within one estimate (e.g. "Option 3:
// upgraded flooring") -- direct port of the OPTION sheet pattern
// (business-rules.md/data-model-v0.md), structurally identical to a
// COMPONENT sheet. Reuses EstimateSection/LineItem rather than a
// parallel model: a section belongs to an Option via
// EstimateSection.optionId instead of duplicating the section/line-item
// shape. Immutable once its parent EstimateVersion is locked, same rule
// as base sections (estimate-service.ts's assertUnlocked).
model Option {
  id                String          @id @default(cuid())
  estimateVersionId String
  estimateVersion   EstimateVersion @relation(fields: [estimateVersionId], references: [id])

  name      String
  sortOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections EstimateSection[]

  @@map("options")
}

enum ChangeOrderStatus {
  DRAFT
  APPROVED
  REJECTED
}

// Stored as two full EstimateVersion snapshots (base + result) rather
// than an explicit delta table -- reuses the versioning/locking machinery
// already built for EstimateVersion instead of inventing a parallel
// storage shape. The "diff" data-model-v0.md recommends for reporting
// clarity is computed on read by comparing baseVersion's line items
// against resultVersion's (see change-order-service.ts) -- an
// intentional divergence from the workbook, which authors each change
// order as an independent from-scratch mini-estimate rather than a diff.
model ChangeOrder {
  id         String   @id @default(cuid())
  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id])

  baseVersionId   String
  baseVersion     EstimateVersion @relation("ChangeOrderBaseVersion", fields: [baseVersionId], references: [id])
  resultVersionId String          @unique
  resultVersion   EstimateVersion @relation("ChangeOrderResultVersion", fields: [resultVersionId], references: [id])

  description String
  status      ChangeOrderStatus @default(DRAFT)

  createdAt  DateTime  @default(now())
  approvedAt DateTime?

  @@map("change_orders")
}

// business-rules.md/data-model-v0.md's Attachment: fileRef is a text
// reference (filename, or an external FTP/WeTransfer link), not an
// uploaded file -- the workbook's own evidence (WORK ORDER!C15) confirms
// artwork already moves outside the workbook entirely via external file
// transfer, so this is a pointer, not a storage pipeline. Minimal
// design-intake prototype only, per explicit decision: no automated
// pull-sheet table extraction this phase.
model Attachment {
  id         String   @id @default(cuid())
  estimateId String
  estimate   Estimate @relation(fields: [estimateId], references: [id])

  fileRef      String
  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id])

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  draftLineItems LineItem[]

  @@map("attachments")
}
