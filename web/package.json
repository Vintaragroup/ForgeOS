{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "lsof -ti:3000 | xargs kill -9 2>/dev/null; while lsof -ti:3000 >/dev/null 2>&1; do sleep 0.2; done",
    "dev": "next dev -p 3000",
    "build": "next build",
    "vercel-build": "if [ \"$VERCEL_ENV\" = \"production\" ]; then npx prisma migrate deploy; fi && npx prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "seed": "tsx prisma/seed.ts",
    "set-password": "tsx scripts/set-password.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "backfill-line-item-categories": "tsx scripts/backfill-line-item-categories.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.5",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-pdf/renderer": "^4.5.1",
    "@tarikjabiri/dxf": "^2.8.9",
    "@vercel/blob": "^2.8.0",
    "exceljs": "^4.4.0",
    "mammoth": "^1.12.0",
    "maxrects-packer": "^2.7.3",
    "next": "16.3.0",
    "openai": "^7.4.0",
    "papaparse": "^5.6.0",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.7",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
