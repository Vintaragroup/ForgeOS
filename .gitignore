# Source workbook — real client/rate data, never goes to the (public) remote.
# The audit tooling expects it at this exact path locally; see docs/audit-plan.md.
/Reference/ORLANDO ESTIMATE.xlsm

# Real employee names to redact from generated artifacts — see
# tools/workbook_audit/redact_local.py's own docstring for why this can't
# be committed either.
/tools/workbook_audit/redact_local.py

# OS
.DS_Store

# Python
__pycache__/
*.pyc
.pytest_cache/

# Editors
.vscode/
.idea/

# Phase 1 generated run output (regenerate with: python3 -m tools.workbook_import.run_phase1)
# Includes the synthetic fixture .xlsm/.xlsx (binary, regenerable) and the
# staging SQLite DB -- not audit deliverables, unlike artifacts/*.json.
/artifacts/phase1_runs/
/artifacts/phase1_staging.db

# Real historical job workbooks -- real client names, rates, and awarded
# prices. Never goes to the (public) remote. See data/historical_jobs/README.md,
# which is the one file in this tree that IS tracked (hence the negation below).
/data/historical_jobs/*
!/data/historical_jobs/README.md

# Real RFP bid documents -- vendor services agreements, financial proposal
# schedules, site plans for actual client events. Same "never goes to the
# public remote" reasoning as data/historical_jobs/ above.
/data/RFP/

# Expo CCI's internal brand identity manual (PDF) -- proprietary company
# material, not something to publish alongside the open app code.
/data/ExpCCI-brandguidelines/
